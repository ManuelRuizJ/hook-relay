# Copy to .env and adjust. Docker Compose and the app read the same file.

# PostgreSQL
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=hookrelay_dev_pw
POSTGRES_DB=hookrelay
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis. The app uses DB 0; tests switch to DB 15 (see tests/conftest.py),
# so a running worker never interferes with pytest.
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
# Uvicorn processes in the api container (one Python process ~ one CPU core)
API_WORKERS=4
LOG_LEVEL=INFO
# json (default, one object per line) or text (human-readable, for local work)
LOG_FORMAT=json

# Worker
WORKER_METRICS_PORT=9100

# Database connections per process (API process or worker). Keep
# processes x (pool + overflow) under Postgres' max_connections (100).
# The worker overrides these to 3 + 2 in docker-compose.yml.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
